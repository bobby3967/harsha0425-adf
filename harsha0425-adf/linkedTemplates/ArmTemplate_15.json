{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "harsha0425-adf"
		},
		"HttpServer99_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'HttpServer99'"
		},
		"HttpServer301_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'HttpServer301'"
		},
		"HttpServer99_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://www.google.com/"
		},
		"HttpServer99_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "123"
		},
		"HttpServer301_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "a"
		},
		"HttpServer301_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "a"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/HttpServer99')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "HttpServer",
				"typeProperties": {
					"url": "[parameters('HttpServer99_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Basic",
					"userName": "[parameters('HttpServer99_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('HttpServer99_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/HttpServer301')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "HttpServer",
				"typeProperties": {
					"url": "[parameters('HttpServer301_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Basic",
					"userName": "[parameters('HttpServer301_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('HttpServer301_password')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}